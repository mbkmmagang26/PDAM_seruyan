rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPER FUNCTIONS (Role-Based Access Control)
    // ─────────────────────────────────────────────

    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/user_admin/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_admin/$(request.auth.uid)).data.role == 'admin';
    }

    function isAccounting() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/user_admin/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_admin/$(request.auth.uid)).data.role == 'accounting';
    }

    function isStaff() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/user_admin/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/user_admin/$(request.auth.uid)).data.role == 'staff' ||
         get(/databases/$(database)/documents/user_admin/$(request.auth.uid)).data.role == 'accounting' ||
         get(/databases/$(database)/documents/user_admin/$(request.auth.uid)).data.role == 'admin');
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isInternalUser() {
      return isAdmin() || isAccounting() || isStaff();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI PENGGUNA
    // ─────────────────────────────────────────────

    // tb_pelanggan: Profil & data teknis pelanggan
    match /tb_pelanggan/{userId} {
      allow read: if request.auth != null && (
        isOwner(userId) || 
        (resource != null && resource.data.userId == request.auth.uid) || 
        isInternalUser()
      );
      allow write: if isOwner(userId) || isAdmin() || isAccounting();
    }

    // user_admin: Akun admin, staff, accounting
    match /user_admin/{userId} {
      allow read: if request.auth != null && (isOwner(userId) || isInternalUser());
      allow write: if isAdmin() || isOwner(userId);
    }

    // ─────────────────────────────────────────────
    // KOLEKSI PERMOHONAN & TUGAS
    // ─────────────────────────────────────────────

    // tb_permohonan: Pengajuan sambungan baru dari pelanggan
    match /tb_permohonan/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isInternalUser()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isInternalUser() || 
        (request.auth != null && resource != null && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // tasks: Tugas kerja yang diberikan ke staff
    match /tasks/{docId} {
      allow read: if request.auth != null && (
        isInternalUser() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow create: if isInternalUser();
      allow update: if isInternalUser();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI LAYANAN PELANGGAN
    // ─────────────────────────────────────────────

    // pengaduan: Laporan gangguan/keluhan dari pelanggan
    match /pengaduan/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isInternalUser()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isInternalUser()
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI KEUANGAN & TAGIHAN
    // ─────────────────────────────────────────────

    // tb_billing: Tagihan air bulanan pelanggan
    match /tb_billing/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isInternalUser()
      );
      allow write: if isAdmin() || isAccounting();
    }

    // tb_meter_pelanggan: Catatan pembacaan meteran
    match /tb_meter_pelanggan/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isInternalUser()
      );
      allow write: if isInternalUser();
    }

    // transactions: Jurnal keuangan
    match /transactions/{docId} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update, delete: if isAdmin() || isAccounting();
    }

    // coa: Chart of Accounts (Master Akun Keuangan)
    match /coa/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isAccounting();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI MASTER DATA
    // ─────────────────────────────────────────────

    // tb_golongan: Master tarif/golongan pelanggan
    match /tb_golongan/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isAccounting();
    }

    // inventory & assets: Data aset dan inventaris
    match /inventory/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isAccounting();
    }
    match /assets/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isAccounting();
    }

    // budgets: Anggaran operasional
    match /budgets/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isAccounting();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI LOG & NOTIFIKASI
    // ─────────────────────────────────────────────

    // customer_activity: Log aktivitas pelanggan
    match /customer_activity/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isInternalUser()
      );
      allow create: if request.auth != null;
      allow update, delete: if false; // Log tidak boleh dimodifikasi
    }

    // tb_activity_user_admin: Log aktivitas staf/admin internal
    match /tb_activity_user_admin/{docId} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update, delete: if false; // Log tidak boleh dimodifikasi
    }

    // notifications: Notifikasi ke pengguna
    match /notifications/{docId} {
      allow read: if request.auth != null && (
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.userId == 'all')) || 
        isInternalUser()
      );
      allow write: if isInternalUser();
    }
  }
}

