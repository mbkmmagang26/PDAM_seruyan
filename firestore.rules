rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPER FUNCTIONS (Role-Based Access Control)
    // ─────────────────────────────────────────────

    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/user_admin/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_admin/$(request.auth.uid)).data.role == 'admin';
    }

    function isAccounting() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/user_admin/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_admin/$(request.auth.uid)).data.role == 'accounting';
    }

    function isStaff() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/user_admin/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/user_admin/$(request.auth.uid)).data.role == 'staff' ||
         get(/databases/$(database)/documents/user_admin/$(request.auth.uid)).data.role == 'accounting' ||
         get(/databases/$(database)/documents/user_admin/$(request.auth.uid)).data.role == 'admin');
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isInternalUser() {
      return isAdmin() || isAccounting() || isStaff();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI PENGGUNA
    // ─────────────────────────────────────────────

    // data_pelanggan_meteran: Profil & data teknis pelanggan
    match /data_pelanggan_meteran/{userId} {
      allow read: if request.auth != null && (
        isOwner(userId) || 
        (resource != null && resource.data.userId == request.auth.uid) || 
        isInternalUser()
      );
      // Explicit create and update to prevent errors and ensure security
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if (request.auth != null && request.auth.uid == userId) || isInternalUser();
      allow delete: if isAdmin();
    }

    // user_admin: Akun admin, staff, accounting
    match /user_admin/{userId} {
      allow read: if request.auth != null && (isOwner(userId) || isInternalUser());
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI PERMOHONAN & TUGAS
    // ─────────────────────────────────────────────

    // permohonan_pasang_baru: Pengajuan sambungan baru dari pelanggan
    match /permohonan_pasang_baru/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isInternalUser()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isInternalUser() || 
        (request.auth != null && resource != null && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // tugas_perbaikan_staf: Perintah kerja & penugasan staf lapangan
    match /tugas_perbaikan_staf/{docId} {
      allow read: if request.auth != null && (
        isInternalUser() ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow create: if isInternalUser();
      allow update: if isInternalUser();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI LAYANAN PELANGGAN
    // ─────────────────────────────────────────────

    // pengaduan_layanan_pelanggan: Laporan gangguan/keluhan dari pelanggan
    match /pengaduan_layanan_pelanggan/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isInternalUser()
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isInternalUser()
      );
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI KEUANGAN & TAGIHAN
    // ─────────────────────────────────────────────

    // tagihan_air_pelanggan: Tagihan air bulanan pelanggan
    match /tagihan_air_pelanggan/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isInternalUser()
      );
      allow write: if isAdmin() || isAccounting();
    }

    // pembacaan_meter_staf: Catatan pembacaan meteran
    match /pembacaan_meter_staf/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        isInternalUser()
      );
      allow write: if isInternalUser();
    }

    // jurnal_transaksi_keuangan: Jurnal keuangan
    match /jurnal_transaksi_keuangan/{docId} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update, delete: if isAdmin() || isAccounting();
    }

    // laporan_penagihan_kasir: LPP Kasir
    match /laporan_penagihan_kasir/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isAccounting();
    }

    // coa: Chart of Accounts (Master Akun Keuangan)
    match /coa/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isAccounting();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI MASTER DATA & VENDOR
    // ─────────────────────────────────────────────

    // master_tarif_air: Master tarif/golongan pelanggan
    match /master_tarif_air/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isAccounting();
    }

    // stok_material_pipa & inventaris_aset_tetap
    match /stok_material_pipa/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isAccounting();
    }
    match /inventaris_aset_tetap/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isAccounting();
    }

    // mitra_vendor_pemasok: Data vendor & pemasok
    match /mitra_vendor_pemasok/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isAccounting();
    }

    // anggaran_operasional: Anggaran operasional
    match /anggaran_operasional/{docId} {
      allow read: if isInternalUser();
      allow write: if isAdmin() || isAccounting();
    }

    // ─────────────────────────────────────────────
    // KOLEKSI LOG & NOTIFIKASI
    // ─────────────────────────────────────────────

    // log_aktivitas_pelanggan: Log aktivitas pelanggan
    match /log_aktivitas_pelanggan/{docId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) || 
        isInternalUser()
      );
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // log_aktivitas_staf_admin: Log aktivitas staf/admin internal
    match /log_aktivitas_staf_admin/{docId} {
      allow read: if isInternalUser();
      allow create: if isInternalUser();
      allow update, delete: if isAdmin();
    }

    // notifikasi_pengguna: Notifikasi ke pengguna
    match /notifikasi_pengguna/{docId} {
      allow read: if request.auth != null && (
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.userId == 'all')) || 
        isInternalUser()
      );
      allow write: if isInternalUser();
    }
  }
}
